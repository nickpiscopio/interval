{
  "name": "interval",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy-android": "eas build --platform android --profile production --auto-submit",
    "deploy-android-local": "eas build --platform android --profile production --local --output=\".dist/builds/build-{timestamp}.aab\"",
    "eject": "expo eject",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:all": "npm run test:coverage && npx tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/types.tsx",
      "!src/model/Badge.ts",
      "!src/model/Exercise.ts",
      "!src/model/Timer.ts",
      "!src/navigation/LinkingConfiguration.ts",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 75,
        "functions": 85,
        "lines": 90
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|i18n-js|@react-native-async-storage/async-storage|react-native-draggable-flatlist|react-native-reanimated)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@react-navigation/stack": "^7.10.24",
    "expo": "^58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "^58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "i18n-js": "^4.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gradient-icon": "^0.2.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "^19.2.7",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-native-masked-view/masked-view": "$@react-native-masked-view/masked-view",
    "react-native-svg": "$react-native-svg",
    "react-native-vector-icons": "$react-native-vector-icons"
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
